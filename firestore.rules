rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function isTreasurer() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'treasurer';
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.role == 'player';
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isSelf(request.resource.data.userId);
      allow update: if isAdmin() || isSelf(resource.data.userId);
      allow delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn()
        && (resource.data.challengerId == request.auth.uid
          || resource.data.challengedId == request.auth.uid
          || isAdmin());
      allow create: if signedIn()
        && request.resource.data.challengerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.challengedId == request.auth.uid || isAdmin())
        && request.resource.data.challengerId == resource.data.challengerId
        && request.resource.data.challengedId == resource.data.challengedId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if signedIn()
        && (resource.data.submittedBy == request.auth.uid
          || isAdmin()
          || (exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
            && (get(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
              .data.challengerId == request.auth.uid
              || get(/databases/$(database)/documents/challenges/$(resource.data.challengeId))
                .data.challengedId == request.auth.uid)));
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
        && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
          .data.status == 'accepted'
        && (get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
          .data.challengerId == request.auth.uid
          || get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
            .data.challengedId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /rankings/{rankingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt']);
      allow create, delete: if false;
    }
  }
}
