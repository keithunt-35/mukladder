rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isApprovedMember(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && (!get(/databases/$(database)/documents/users/$(uid))
          .data.keys().hasAny(['registrationStatus'])
          || get(/databases/$(database)/documents/users/$(uid))
            .data.registrationStatus == 'approved');
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    function isTreasurer() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'treasurer';
    }

    function activityTimestampIsServerTime() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['lastActivityAt'])
        || request.resource.data.lastActivityAt == request.time;
    }

    function challengeExists(challengeId) {
      return exists(
        /databases/$(database)/documents/challenges/$(challengeId)
      );
    }

    function isChallengeParticipant(challengeId) {
      return signedIn()
        && challengeExists(challengeId)
        && (get(
          /databases/$(database)/documents/challenges/$(challengeId)
        ).data.challengerId == request.auth.uid
          || get(
            /databases/$(database)/documents/challenges/$(challengeId)
          ).data.challengedId == request.auth.uid);
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'role',
          'status',
          'registrationStatus',
          'joinRequestStatus',
          'paymentStatus',
          'photoUrl',
          'photoStoragePath',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'player'
        && request.resource.data.status == 'active'
        && request.resource.data.registrationStatus == 'notRequested'
        && request.resource.data.joinRequestStatus == 'notRequested'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isSelf(uid) || isAdmin();
      allow update: if (isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'photoUrl',
            'photoStoragePath',
            'lastActivityAt',
            'updatedAt'
          ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && activityTimestampIsServerTime());
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if isAdmin()
        || isSelf(resource.data.userId)
        || isApprovedMember(request.auth.uid);
      allow create: if isSelf(request.resource.data.userId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'displayName',
            'photoUrl',
            'photoStoragePath',
            'joinRequestStatus',
            'paymentStatus',
            'registrationStatus',
            'active',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.active == false
          && request.resource.data.registrationStatus == 'notRequested'
          && request.resource.data.joinRequestStatus == 'notRequested'
          && request.resource.data.paymentStatus == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if (isSelf(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'photoUrl',
              'photoStoragePath',
              'lastActivityAt',
              'updatedAt'
            ])
          && activityTimestampIsServerTime());
      allow delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isAdmin()
        || isTreasurer()
        || (isApprovedMember(request.auth.uid)
          && (resource.data.challengerId == request.auth.uid
            || resource.data.challengedId == request.auth.uid));
      allow create: if signedIn()
        && isApprovedMember(request.auth.uid)
        && request.resource.data.challengerId == request.auth.uid
        && request.resource.data.challengedId != request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['normal', 'god'];
      allow update: if isAdmin()
        || (isApprovedMember(request.auth.uid)
        && request.resource.data.challengerId == resource.data.challengerId
        && request.resource.data.challengedId == resource.data.challengedId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.status == 'pending'
            && resource.data.challengedId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt', 'alternativeDate'])
            && request.resource.data.respondedAt == request.time
            && request.resource.data.status
              in ['accepted', 'rejected', 'alternativeDateProposed'])
          || (resource.data.status == 'alternativeDateProposed'
            && resource.data.challengerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt', 'proposedDate'])
            && request.resource.data.respondedAt == request.time
            && request.resource.data.status in ['accepted', 'rejected']
            && (request.resource.data.status == 'rejected'
              || request.resource.data.proposedDate
                == resource.data.alternativeDate))
          || (resource.data.status == 'accepted'
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['resultId', 'resultSubmittedAt'])
            && request.resource.data.resultSubmittedAt == request.time
            && existsAfter(
              /databases/$(database)/documents/results/$(request.resource.data.resultId)
            )
            && getAfter(
              /databases/$(database)/documents/results/$(request.resource.data.resultId)
            ).data.challengeId == challengeId)
        ));
      // Challenge completion after confirmed results is Cloud Functions only.
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin()
        || isTreasurer()
        || (isApprovedMember(request.auth.uid)
          && isChallengeParticipant(resource.data.challengeId));
      allow create: if signedIn()
        && isApprovedMember(request.auth.uid)
        && request.resource.data.submittedBy == request.auth.uid
        && challengeExists(request.resource.data.challengeId)
        && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
          .data.status == 'accepted'
        && (get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
          .data.challengerId == request.auth.uid
          || get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
            .data.challengedId == request.auth.uid)
        && request.resource.data.status == 'submitted'
        && request.resource.data.score is string
        && request.resource.data.submittedAt == request.time
        && request.resource.data.score.matches('^[0-9]+-[0-9]+(, ?[0-9]+-[0-9]+)*$')
        && getAfter(
          /databases/$(database)/documents/challenges/$(request.resource.data.challengeId)
        ).data.resultId == resultId;
      // Confirmation (and ranking mutation) is Cloud Functions only.
      // Clients may only dispute a submitted score.
      allow update: if isAdmin()
        || (isApprovedMember(request.auth.uid)
          && isChallengeParticipant(resource.data.challengeId)
          && request.auth.uid != resource.data.submittedBy
          && resource.data.status == 'submitted'
          && request.resource.data.status == 'disputed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.reviewedBy == request.auth.uid);
      allow delete: if false;
    }

    match /rankings/{rankingId} {
      allow read: if isAdmin() || isApprovedMember(request.auth.uid);
      allow write: if false;
    }

    match /playerPoints/{playerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /playerPointEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt']);
      allow create, delete: if false;
    }
  }
}
